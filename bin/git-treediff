#!/usr/bin/env bash
#
# meld folder diff of the whole repo -- lazygit's <c-t>/T.
#
# `git difftool -d` copies only the changed files into its temp dirs, so the
# tree it opens has nothing else in it. Here the left side is a full checkout
# of the ref and the right side is the working tree itself, live: what meld
# saves there lands in your files.

set -euo pipefail

die() { printf 'git-treediff: %s\n' "$*" >&2; exit 1; }

command -v meld >/dev/null 2>&1 || die 'meld is not installed'

# a tag or branch name is just as good a left side
ref=${1:-HEAD}
git rev-parse --verify --quiet "$ref^{commit}" >/dev/null || die "not a commit: $ref"
top=$(git rev-parse --show-toplevel)

# the ref names the leaf, so the pane is labelled with it and not XXXXXX
tmp=$(mktemp -d -t git-treediff.XXXXXXXX)
trap 'rm -rf -- "$tmp"' EXIT
old=$tmp/$(printf '%s' "$ref" | tr -c 'A-Za-z0-9._-' '_')
mkdir -p -- "$old"

# an archive, not a worktree: tracked files at that ref and no .git of its own
git archive --format=tar "$ref" | tar -x -C "$old"

# -a compares the differing files up front rather than on each click; the
# labels keep the panes from both reading as a temp path.
meld -a -L "$ref" -L 'working tree' -- "$old" "$top"
